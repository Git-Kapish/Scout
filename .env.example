# Scout Environment Configuration

# LLM Providers (PRD §5: USD 0 spend constraint, free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional co-providers
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Search Providers (PRD §5.4: Tavily primary, DuckDuckGo/SearXNG fallback)
TAVILY_API_KEY=your_tavily_api_key_here
SEARXNG_BASE_URL=http://localhost:8080

# Datastore
REDIS_URL=redis://localhost:6379/0

# Execution Mode: live | record | replay (PRD §5.3 #1)
SCOUT_MODE=live

# Fault Injection for crash recovery testing (PRD §7.4 FR-4.6, 0 in production)
SCOUT_FAULTS_ENABLED=0
SCOUT_CRASH_AT=

# API Security (Optional)
SCOUT_API_KEY=
